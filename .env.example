# Set the public production origin before deployment. No trailing path.
NEXT_PUBLIC_SITE_URL=
# Public business contact email, optional. Hidden until configured.
NEXT_PUBLIC_CONTACT_EMAIL=
# Public Formspree endpoint used by the Contact / RFQ form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xjywkpzg
# Future server-only Resend integration. Never prefix secrets with NEXT_PUBLIC_.
# RESEND_API_KEY=

# International WhatsApp number: digits only, no + or spaces. Rebuild after editing.
# Empty or invalid values fall back to the public business number in lib/whatsapp.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=8618673309556
